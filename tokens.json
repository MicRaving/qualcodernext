  "meta": {
    "name": "QualCoder v4 design tokens",
    "version": "1.0.0",
    "description": "Single source of truth for colors, spacing, radii, typography and icons. Consumed by the React frontend (Tailwind CSS v4 @theme) and referenced by the backend where generated output needs styling."
