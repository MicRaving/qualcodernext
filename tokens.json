  "spacing": {
    "xs": "2px",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px"
  },
  "radius": {
    "sm": "3px",
    "md": "4px",
    "lg": "8px"
  },
  "typography": {
    "family": "Inter, system-ui, -apple-system, sans-serif",
    "caption": {
      "size": "10px",
      "weight": 400,
      "lineHeight": 1.4
    },
    "body": {
      "size": "12px",
      "weight": 400,
      "lineHeight": 1.5
    },
    "heading": {
      "size": "14px",
      "weight": 600,
      "lineHeight": 1.4
    },
    "display": {
      "size": "28px",
      "weight": 700,
      "lineHeight": 1.2
    }
  },
  "icons": {
    "toolbar": "20px",
    "sidebar": "16px",
    "inline": "14px"
  },
  "motion": {
    "fast": "150ms",
    "base": "200ms",
    "slow": "250ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "shell": {
    "toolbarHeight": "40px",
    "statusBarHeight": "24px",
    "sidebarMin": "260px",
    "sidebarMax": "300px",
    "inspectorMin": "280px",
    "inspectorMax": "320px"
  }
