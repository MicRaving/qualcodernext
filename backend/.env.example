# QualCoder server — copy to .env and fill in.
#   python -m qualcoder_api.cli secret   # generates QC_SECRET_KEY candidates
# WARNING: the placeholder secrets below must be replaced before first start —
# the entrypoint refuses to boot with the defaults.

QC_SERVER_MODE=true
QC_SECRET_KEY=REPLACE-ME-generate-with-python-m-qualcoder_api-cli-secret

# Storage root inside the container (compose mounts the `data` volume here).
QC_DATA_DIR=/data/qualcoder

# Bearer-token lifetime in seconds (default 7 days).
# QC_TOKEN_TTL_SECS=604800

# WebAuthn passkeys: set to your public hostname; origin defaults to https://<id>.
# QC_RP_ID=qualcoder.example.com
# QC_RP_ORIGIN=https://qualcoder.example.com

# Extra CORS origins (comma-separated) if the frontend is served from another host.
# QC_CORS_ORIGINS=

# Idle project sessions close after this many seconds.
# QC_SESSION_IDLE_SECS=900

# Upload cap in bytes (default 2 GiB).
# QC_MAX_UPLOAD_BYTES=2147483648

# First-run admin bootstrap (entrypoint skips when users exist).
# WARNING: replace both values; weak/default credentials are rejected at boot.
QC_ADMIN_USER=admin
QC_ADMIN_PASS=REPLACE-ME-min-12-chars

# Cloud backup mirror (Phase 4 sidecar).
# QC_BACKUP_RETENTION=daily=14,weekly=8,monthly=12
# QC_RCLONE_CONF=/config/rclone/rclone.conf
# QC_RCLONE_REMOTE=qcnext-crypt:
